/// Synthetic (generate_operations.py, seeded) — badged in the app.
table Zones

	column id
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: id

	column name
		dataType: string
		summarizeBy: none
		sourceColumn: name

	column kind
		dataType: string
		summarizeBy: none
		sourceColumn: kind

	column sequence
		dataType: int64
		summarizeBy: none
		sourceColumn: sequence

	column colour
		dataType: string
		summarizeBy: none
		sourceColumn: colour

	column note
		dataType: string
		summarizeBy: none
		sourceColumn: note

	column areaM2
		dataType: double
		formatString: #,0
