		sourceColumn: areaM2

	column spanM
		dataType: double
		summarizeBy: none
		sourceColumn: spanM

	column widthM
		dataType: double
		summarizeBy: none
		sourceColumn: widthM

	column centreAlongM
		dataType: double
		summarizeBy: none
		sourceColumn: centreAlongM

	column rackRows
		dataType: int64
		summarizeBy: none
		sourceColumn: rackRows

	column tempC
		dataType: double
		summarizeBy: none
		sourceColumn: tempC

	column lineShare
		dataType: double
		formatString: 0%
		summarizeBy: none
		sourceColumn: lineShare

	column peakFte
		dataType: int64
		summarizeBy: none
		sourceColumn: peakFte


	partition Zones = entity
		mode: directLake
		source
			entityName: dc_zone
			expressionSource: DatabaseQuery
