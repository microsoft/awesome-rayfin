/// Compact wholesaler P&L (German GAAP, nature-of-expense format) with the cockpit's formula rows N-REV, F-GP, F-EBITDA, F-EBIT, F-EBT, F-NI.
table 'dim-account'

	column AccountID
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: AccountID

	column ParentAccountID
		dataType: string
		summarizeBy: none
		sourceColumn: ParentAccountID

	column Name
		dataType: string
		summarizeBy: none
		sourceColumn: Name

	column L1
		dataType: string
		summarizeBy: none
		sourceColumn: L1

	column L2
		dataType: string
		summarizeBy: none
		sourceColumn: L2

	column L3
		dataType: string
		summarizeBy: none
		sourceColumn: L3

	column L4
		dataType: string
		summarizeBy: none
		sourceColumn: L4

	column L5
		dataType: string
		summarizeBy: none
		sourceColumn: L5

	column L6
		dataType: string
		summarizeBy: none
		sourceColumn: L6

	column SortOrder
		dataType: int64
		summarizeBy: none
		sourceColumn: SortOrder

	column RowType
		dataType: string
		summarizeBy: none
		sourceColumn: RowType

	column FormulaDef
		dataType: string
		summarizeBy: none
		sourceColumn: FormulaDef

	column SignConvention
		dataType: int64
		summarizeBy: none
		sourceColumn: SignConvention

	column DisplayInvert
		dataType: string
		summarizeBy: none
		sourceColumn: DisplayInvert

	column VarianceInvert
		dataType: string
		summarizeBy: none
		sourceColumn: VarianceInvert

	column Comment
		dataType: string
		summarizeBy: none
		sourceColumn: Comment

	partition 'dim-account' = entity
		mode: directLake
		source
			entityName: fin_dim_account
			expressionSource: DatabaseQuery
