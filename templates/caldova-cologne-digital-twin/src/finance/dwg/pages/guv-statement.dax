// Queries of the page "Income statement" without cross-filters, for checking in the DAX query view.
// Generated by `dwg app page`; patched by tools/finance/dwg-english.mjs.

// Tile statement (pnl)
EVALUATE
    SUMMARIZECOLUMNS(
        'dim-account'[AccountID],
        'dim-account'[Name],
        'dim-account'[L1],
        'dim-account'[L2],
        'dim-account'[L3],
        'dim-account'[SortOrder],
        'dim-account'[RowType],
        'dim-account'[FormulaDef],
        'dim-account'[SignConvention],
        'dim-account'[DisplayInvert],
        'dim-account'[VarianceInvert],
        'dim-account'[Comment],
        TREATAS({2026}, 'Calender'[Year]),
        TREATAS({1, 2, 3, 4, 5, 6, 7, 8, 9}, 'Calender'[Month]),
        "ac", 'fact-pnl'[P&L AC],
        "py", 'fact-pnl'[P&L PY],
        "pl", 'fact-pnl'[P&L PL]
    )
ORDER BY 'dim-account'[AccountID], 'dim-account'[Name], 'dim-account'[L1], 'dim-account'[L2], 'dim-account'[L3], 'dim-account'[SortOrder], 'dim-account'[RowType], 'dim-account'[FormulaDef], 'dim-account'[SignConvention], 'dim-account'[DisplayInvert], 'dim-account'[VarianceInvert], 'dim-account'[Comment]
