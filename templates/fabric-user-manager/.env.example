# Fabric User Manager — build values.
#
# Copy to `.env` and fill in your ids, or pass them as environment variables to the build.
# `.env` is gitignored because a real deployment puts tenant-specific ids in it.
# Every value here is an id, not a credential. The setup guide explains each one:
# docs/FABRIC-USER-MANAGER-SETUP.md
#
# `npx rayfin env` writes the Rayfin values (API address, publishable key, tenant)
# into `.env.local`, which takes precedence; you do not set those here.

# Client id of the app's own registration in Entra (single-page app, the app's
# address as redirect URI, delegated Graph and Power BI permissions).
VITE_UM_CLIENT_ID=

# Who is app admin. Either the object id of an Entra security group whose members
# are app admins, or object ids of individual people separated by commas, or both.
# Fixed at build time on purpose: it is not a setting in the app database.
VITE_UM_ADMIN_GROUP_ID=
VITE_UM_ADMIN_USER_IDS=

# `true` puts member changes, requests and workspace role bindings into the build.
# Even then, every kind of change stays off until an app admin switches it on in
# Setup. Leave it empty for a build that cannot change anything in Entra or Fabric.
VITE_UM_WRITES=

# `true` runs the app on invented people and groups, with no tenant and no backend.
# Pick the person with ?as=admin, ?as=owner or ?as=user. Never set it for a deployment.
VITE_UM_MOCK=
