# .env.example — copy to `.env` if you need to override defaults.
#
# The OFFLINE DEMO NEEDS NONE OF THESE. It runs entirely on bundled sample data
# (`staticDataSource`) with no network calls and no secrets.
#
# These values matter only when wiring a LIVE Fabric semantic model. On the Rayfin
# platform they are INJECTED AT DEPLOY TIME (see manifest.json `tokens`) — you do
# not paste secrets here. Fabric auth is host-brokered: the portal supplies the
# access token at runtime, so there is no client secret / API key to store.

# Rayfin service endpoint (platform-injected as __RAYFIN_API_URL__).
# VITE_RAYFIN_API_URL=

# Rayfin publishable key (platform-injected as __RAYFIN_PK__). Not a secret.
# VITE_RAYFIN_PK=

# Fabric item / workspace identifiers (platform-injected).
# VITE_FABRIC_ITEM_ID=
# VITE_FABRIC_WORKSPACE_ID=
# VITE_FABRIC_PORTAL_URL=
