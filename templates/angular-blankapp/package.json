{
  "name": "angular-blankapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "angular-blankapp",
    "displayName": "Angular Blank App",
    "description": "Bare-bones Fabric-authenticated Angular + Material app — sign-in, routing, and a placeholder home page, with no data layer to remove"
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "prebuild:fabric": "rayfin env --framework vite",
    "pretest": "rayfin env --framework vite",
    "dev": "rayfin up && ng serve --port 5173",
    "build": "ng build",
    "build:fabric": "ng build",
    "lint": "eslint .",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "rayfin:up": "rayfin up"
  },
  "dependencies": {
    "@angular/animations": "^21.2.20",
    "@angular/common": "^21.2.20",
    "@angular/compiler": "^21.2.20",
    "@angular/core": "^21.2.20",
    "@angular/forms": "^21.2.20",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.20",
    "@angular/router": "^21.2.20",
    "@microsoft/rayfin-auth-provider-fabric": "^1.34.0",
    "@microsoft/rayfin-client": "^1.34.0",
    "@microsoft/rayfin-core": "^1.34.0",
    "@microsoft/rayfin-data": "^1.32.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/eslint-plugin": "^21.0.0",
    "@angular-eslint/eslint-plugin-template": "^21.0.0",
    "@angular-eslint/template-parser": "^21.0.0",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.20",
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.34.0",
    "@ngx-env/builder": "^21.0.0",
    "@types/jasmine": "~5.1.0",
    "eslint": "^9.28.0",
    "globals": "^16.0.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.38.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "tar": "7.5.22",
    "vite": {
      "esbuild": "0.28.1"
    },
    "tsx": {
      "esbuild": "0.28.1"
    },
    "@azure/msal-node": {
      "uuid": "11.1.1"
    },
    "@microsoft/rayfin-cli": {
      "uuid": "11.1.1"
    },
    "@opentelemetry/otlp-transformer": {
      "protobufjs": "8.8.0"
    },
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/propagator-jaeger": "2.11.0",
    "karma": {
      "body-parser": "1.20.6"
    },
    "qs": "6.16.0"
  }
