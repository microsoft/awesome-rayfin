{
  "name": "maritime-insights",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "template": {
    "name": "maritime-insights",
    "displayName": "Maritime Insights",
    "description": "Interactive 3D coastal twin of the Kiel Fjord, built entirely from open geodata — true-scale DGM1 terrain with LoD2 buildings and an orthophoto drape, a coarse Copernicus DEM shell for the horizon, and a geometric sensor-visibility model that is explicitly not a radar model."
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:fabric": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "relay": "node server/ais/relay.js",
    "relay:replay": "node server/ais/relay.js --replay public/terrain/kieler-foerde",
    "data:build": "python tools/geodata/pipeline.py"
  },
  "dependencies": {
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.2",
    "@microsoft/rayfin-client": "^1.33.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/rayfin-cli": "^1.33.0",
    "@microsoft/rayfin-core": "^1.33.2",
    "@playwright/test": "^1.60.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.28.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.3.2",
    "vitest": "^3.2.7"
  }
}
