# Dependencies
node_modules/
.venv/
__pycache__/
*.pyc

# Build output
dist/
build/
*.tsbuildinfo

# Secrets — never commit
.env
.env.local
.env.*.local
*.pem
*.key

# Rayfin deployment state — contains tenant/workspace GUIDs and the publishable key.
# This repo is destined for Jumpstart / awesome-rayfin (PLAN §14 Q6), so none of it ships.
rayfin/.env
rayfin/.deployments.json
rayfin/.lockfile.json
rayfin/.temp/

# Test output
test-results/
playwright-report/
.playwright-mcp/

# Raw + intermediate geodata (large, redownloadable — see NOTICE.md for sources)
# ⚠️ Anchored to the repo root on purpose. A bare `data/` also matches `src/data/` and
# `rayfin/data/`, which silently drops the fact register and the Rayfin schema from the repo — and
# the symptom is a fresh clone that does not compile.
/data/
*.laz
*.las
*.tif
*.tiff
*.gml
*.xyz

# Generated browser terrain. Tens of megabytes, and reproducible from open sources at any time
# with `python tools/geodata/pipeline.py` — which is why the app ships a SetupNotice explaining
# how to build it rather than assuming it is there.
public/terrain/

# ⚠️ The bundled flights are NOT ignored, and that is deliberate. They are anonymised at import
# (tools/flights/anonymise_igc.py strips the pilot, glider and logger-serial records), they are
# small, and the app is meant to have something to show on a fresh clone. Raw logs straight off an
# instrument must never be added here — run them through the anonymiser.
!public/flights/

*.zip

# Generated app assets (rebuilt by tools/geodata)
public/terrain/
public/buildings/
public/drape/
*.ktx2
*.glb

# Local scratch
temp/
scratch/
*.log

# OS / editor
.DS_Store
Thumbs.db
.vscode/settings.json

# Curated analytical tables (regenerated by tools/geodata/build_portfolio.py)
/data/curated/

# Fabric item ids (workspace/lakehouse/model GUIDs)
tools/fabric/.fabric-ids.json
