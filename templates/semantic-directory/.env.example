# Semantic Directory — front-end environment (EXAMPLE)
#
# You do NOT need any of these to run the app. With no configuration the app
# boots into DEMO mode against the bundled Contoso Sales sample model.
#
# These five VITE_* vars are what the app actually reads at runtime. In the
# normal Rayfin workflow you do NOT edit this file — you set values in
# `rayfin/.env` (see rayfin/.env.example) and run `rayfin env`, which generates
# `.env.local` with exactly these vars. Only create a real `.env.local` from
# this template if you are wiring the Vite env directly (e.g. a custom deploy).
#
# When ALL five are set, the app switches to LIVE mode and introspects your
# configured Fabric workspace + semantic model.

# Rayfin API base URL (e.g. http://localhost:5168 or your deployed backend)
VITE_RAYFIN_API_URL=

# Rayfin publishable key (pk-...)
VITE_RAYFIN_PUBLISHABLE_KEY=

# Fabric workspace ID (GUID) hosting your semantic model
VITE_FABRIC_WORKSPACE_ID=

# Fabric item ID (GUID) of this data app
VITE_FABRIC_ITEM_ID=

# Fabric portal base URL (https://app.fabric.microsoft.com)
VITE_FABRIC_PORTAL_URL=
