{
  "name": "rayfin-semantic-directory",
  "description": "A living, explainable directory for any Power BI / Fabric semantic model. Plug in your workspace + model for live search, measure DNA, lineage, and relationships — or explore the bundled demo model with zero setup. A Rayfin Fabric Data App template.",
  "license": "MIT",
  "author": "Microsoft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "template": {
    "name": "semantic-directory",
    "displayName": "Semantic Directory",
    "description": "A live, searchable directory for any Power BI or Fabric semantic model — search measures and fields, trace lineage and relationships, inspect measure DNA and change impact, and explore a bundled demo model with zero setup."
  },
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "npx fabric-app-data generate -o src/fabric.generated.ts && tsc -b && vite build",
    "build:fabric": "npx fabric-app-data generate -o src/fabric.generated.ts && tsc -b && vite build",
    "build:demo": "node scripts/build-demo-data.mjs",
    "lint": "eslint .",
    "size:check": "node scripts/size-budget.mjs",
    "build:analyze": "npm run build && node scripts/size-budget.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fabric": "node scripts/open-fabric-portal.mjs"
  },
  "dependencies": {
    "@microsoft/fabric-app-data": "1.1.0",
    "@microsoft/fabric-app-data-embed-client": "1.0.0",
    "@microsoft/fabric-app-data-proxy": "1.0.0",
    "@microsoft/fabric-datagrid": "1.1.0",
    "@microsoft/fabric-visuals": "1.1.1",
    "@microsoft/fabric-visuals-core": "1.1.1",
    "@microsoft/rayfin-auth-provider-fabric": "^1.33.1",
    "@microsoft/rayfin-client": "^1.33.1",
    "@microsoft/rayfin-core": "^1.33.1",
    "@microsoft/rayfin-data": "^1.33.1",
    "@microsoft/rayfin-lib": "^1.33.1",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/fabric-app-data-cli": "1.1.0",
    "@microsoft/fabric-app-data-cli-proxy": "1.0.0",
    "@microsoft/rayfin-cli": "^1.33.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
