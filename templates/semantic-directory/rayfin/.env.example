# Rayfin environment configuration — EXAMPLE
#
# Copy this file to `rayfin/.env` and fill in the values for YOUR Fabric
# deployment, OR just run `rayfin up` and let the CLI generate/manage it for you.
# `rayfin/.env` and `rayfin/.deployments.json` are gitignored — they are per-user,
# per-deployment, and should never be committed.
#
# You do NOT need any of these to run the app in DEMO mode locally
# (`npm run dev`) — the app ships with a bundled sample model.
#
# `rayfin env` reads these and generates `.env.local` with the VITE_* vars the
# app reads at runtime (see ../.env.example for that mapping).

RAYFIN_PUBLIC_API_URL=<your-appbackend-api-url>
RAYFIN_PUBLIC_PUBLISHABLE_KEY=<your-publishable-key>
RAYFIN_PUBLIC_ITEM_ID=<your-fabric-item-id>
RAYFIN_PUBLIC_WORKSPACE_ID=<your-fabric-workspace-id>
RAYFIN_PUBLIC_TENANT_ID=<your-tenant-id>
RAYFIN_PUBLIC_PORTAL_URL=https://app.fabric.microsoft.com
