# Caldova Finance: build and deploy values. Copy to .env (git-ignored). Ids only, no credentials.
#
# Who may sign a close off. CONTROLLER_EMAILS is compiled into the data API's row policy at `rayfin up`;
# VITE_CONTROLLER_EMAILS only decides whether the app shows the button. Comma-separated sign-in addresses.
CONTROLLER_EMAILS=
VITE_CONTROLLER_EMAILS=

# The app's tenant, so a guest's sign-in window opens in the right tenant (adds ?ctid= to the portal URL).
VITE_FABRIC_TENANT_ID=

# For the bake and the live mode: where the semantic model lives.
FABRIC_TENANT_ID=
FABRIC_WORKSPACE_ID=
FABRIC_MODEL_ID=

# true: read the model live through the connector (see README; the deployed app is then owner-only).
VITE_LIVE_MODEL=

# true: offline demo, no tenant (same as `npm run dev:offline`). Never set it for a deployment.
VITE_OFFLINE=
