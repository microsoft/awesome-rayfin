# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Rayfin local env (auto-generated by `rayfin env` — contains backend keys)
.env.local
.env

# Rayfin build temp / compiled artifacts
rayfin/.temp/

# Deployment state — tenant-specific ids written by `rayfin up`, not source
rayfin/.deployments.json

# Logs
*.log
npm-debug.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/


# Fabric target ids (tenant-specific)
tools/fabric/target.json
# Probe screenshots and deploy logs
/logs/
# Generator intermediates (regenerable); only the top-level folder, not public/data or rayfin/data
/data/

