# Files that live in this repository but must NOT be carried into a scaffolded app or into
# the public awesome-rayfin gallery. `.gitignore` is not enough: it only controls what git
# tracks, this controls what the template ships.

# Deployment state and generated env - tenant specific.
rayfin/.env
rayfin/.deployments.json
.env.local

# Build output and vendored Cesium assets (regenerated by `npm run cesium:assets`).
dist/
public/cesium/
*.tsbuildinfo

# Fabric item definitions are templates - the concrete ids they still carry are rewritten by
# fabric/deploy at provisioning time - but the recorded deployment state must not ship.
fabric/deploy/.state.json
__pycache__/

# Local scratch.
.DS_Store
