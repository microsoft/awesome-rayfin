# Copy to .env.local.overrides or export in your shell.
#
# The five VITE_RAYFIN_* / VITE_FABRIC_* variables are generated into .env.local by
# `rayfin env --framework vite` (which the predev/prebuild scripts run for you) - you do not
# set those by hand. Everything below is only needed for the standalone sign-in path, i.e.
# when the app runs outside the Fabric portal and cannot use the portal's postMessage bridge.

# Entra ID single-page application used to acquire a Power BI token.
# Needs the Power BI Service delegated scope Dataset.Read.All and an SPA redirect URI
# for every origin the app is served from (localhost and the deployed Fabric App URL).
VITE_PBI_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Tenant that owns the workspace. Used as the MSAL authority and appended to the Fabric
# portal URL as ?ctid=..., so a user with several tenants lands in the right one.
VITE_PBI_TENANT_ID=00000000-0000-0000-0000-000000000000

# Semantic model queried with DAX. Must be the model in VITE_FABRIC_WORKSPACE_ID.
VITE_PBI_DATASET_ID=00000000-0000-0000-0000-000000000000
