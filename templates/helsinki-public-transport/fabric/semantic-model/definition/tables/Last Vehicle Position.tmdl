		annotation SummarizationSetBy = Automatic

	partition 'Last Vehicle Position' = m
		mode: directQuery
		source =
				let
				Source = AzureDataExplorer.Contents("https://<eventhouse>.kusto.fabric.microsoft.com", "00000000-0000-0000-0000-000000000000", "last_vehicle_position
				| where timestamp > ago(2h)
				| join kind=leftouter (
				    alerts
				    | where timestamp > ago(5m)
				    | summarize alerts_json=tostring(make_list(pack_all())) by vehicle_id
				) on vehicle_id
				| project-away  vehicle_id1
				| sort by timestamp desc", [])
				in
				Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

