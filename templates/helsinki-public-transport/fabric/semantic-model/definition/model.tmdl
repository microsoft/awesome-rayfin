model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation ModelPopulated = value

annotation PBI_QueryOrder = ["Last Vehicle Position","Selected_Vehicle","Selected_Vehicle_Path","Vehicles","Number_Positions"]

annotation PBI_ProTooling = ["WebModelingEdit","DaxQueryView_Desktop","DaxCopilot_Change_Accepted_In_Desktop"]

ref table 'Last Vehicle Position'
ref table Selected_Vehicle_Path
ref table Vehicles
ref table Number_Positions

