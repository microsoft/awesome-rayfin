model Model
	culture: en-US
	defaultMode: directLake
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DatabaseQuery", "RayfinDatabase"]

/// Bound at deploy time by deploy.sh / deploy.ps1. The placeholder is replaced with a
/// OneLake path, or with a SQL analytics endpoint when FABRIC_MODEL_STORAGE_MODE=sql.
expression DatabaseQuery =
		let
			Source = {{DATABASE_QUERY_SOURCE}}
		in
			Source

/// The Rayfin app's own SQL database, which Fabric mirrors into OneLake as Delta.
/// Reorders written by the app land here, so the model reads them from the same
/// place the app writes them. Bound at deploy time, like DatabaseQuery above.
expression RayfinDatabase =
		let
			Source = {{RESTOCK_QUERY_SOURCE}}
		in
			Source

ref table Stores
ref table Products
ref table Inventory
ref table Sales
ref table RestockRequests

relationship SalesToStores
	fromColumn: Sales.store_id
	toColumn: Stores.store_id

relationship SalesToProducts
	fromColumn: Sales.sku
	toColumn: Products.sku

relationship InventoryToStores
	fromColumn: Inventory.store_id
	toColumn: Stores.store_id

relationship InventoryToProducts
	fromColumn: Inventory.sku
	toColumn: Products.sku

relationship RestockRequestsToStores
	fromColumn: RestockRequests.store_id
	toColumn: Stores.store_id

relationship RestockRequestsToProducts
	fromColumn: RestockRequests.sku
	toColumn: Products.sku

/// Scopes a regional manager to the regions they are responsible for, using the signed-in
/// identity. Defined but unassigned: it changes nothing until a member is added to the role.
role RegionalManager
	modelPermission: read

	tablePermission Stores =
			VAR ManagedRegions =
			    CALCULATETABLE(
			        VALUES(Stores[region]),
			        ALL(Stores),
			        Stores[manager_upn] = USERPRINCIPALNAME()
			    )
			RETURN
			    Stores[region] IN ManagedRegions
