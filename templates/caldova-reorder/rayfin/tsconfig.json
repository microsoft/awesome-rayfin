{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022", "ESNext.Decorators"],
    "outDir": ".temp/compiled",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "composite": true,
    "declaration": true
  },
  "include": ["data/**/*"],
  "exclude": ["dist", "node_modules", "functions", "connectors"]
}
