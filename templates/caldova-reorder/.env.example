# Copy this file to .env and fill in your values. .env is gitignored.

# ---------------------------------------------------------------------------
# Fabric target
# ---------------------------------------------------------------------------

# The workspace must already exist. deploy.sh / deploy.ps1 never create or
# delete a workspace. Set the ID when you have it; otherwise set the exact
# name and the script will look it up. If both are set, they must agree.
FABRIC_WORKSPACE_ID=
FABRIC_WORKSPACE_NAME=

# Created inside that workspace if they do not already exist.
FABRIC_LAKEHOUSE_NAME=caldova
FABRIC_SEMANTIC_MODEL_NAME=caldova-operations

# ---------------------------------------------------------------------------
# The Rayfin app (this folder)
# ---------------------------------------------------------------------------
# Reorders are written by the app into its own Fabric SQL database, which Fabric
# mirrors into OneLake as Delta. The semantic model reads RestockRequests from
# there with Direct Lake, so the app and the model can never disagree.
#
# Both ids come from the Rayfin deployment. Deploy the app first:
#
#   npx rayfin up
#
# then find the "<app name>" SQLDatabase and SQLEndpoint items in the workspace:
#
#   fabio item list --workspace <workspace> --all
RAYFIN_SQL_DATABASE_ID=
RAYFIN_SQL_ENDPOINT_ID=

# How the semantic model reads the lakehouse.
#   onelake — Direct Lake straight onto OneLake Delta files (recommended)
#   sql     — Direct Lake through the SQL analytics endpoint (fallback)
FABRIC_MODEL_STORAGE_MODE=onelake

# Optional. Assigns the workspace to this capacity before deploying.
FABRIC_CAPACITY_ID=

# ---------------------------------------------------------------------------
# Filled in by the script after a successful run. Leave blank the first time.
# ---------------------------------------------------------------------------
FABRIC_LAKEHOUSE_ID=
FABRIC_SQL_ENDPOINT_ID=
FABRIC_SEMANTIC_MODEL_ID=
