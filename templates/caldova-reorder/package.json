{
  "name": "caldova-reorder",
  "template": {
    "name": "caldova-reorder",
    "displayName": "Caldova Reorder",
    "description": "The original Caldova pharmacy-operations app from Microsoft's LTG291 Rayfin session: a regional manager's low-stock queue over a Direct Lake semantic model with row-level security, read through the Rayfin semantic-model connector, and reorders sent through a Rayfin function into the app's own SQL database, mirrored back into the model. Ships the model, a deterministic synthetic data generator and the deploy scripts. The combined Caldova app is caldova-cologne-digital-twin."
  },
  "description": "This is a starter template for building Fabric Apps - Analytics web apps. Clone this repo locally and follow the steps below to get started.",
  "license": "MIT",
  "author": "Microsoft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "rayfin env --framework vite",
    "prebuild": "rayfin env --framework vite",
    "dev": "vite",
    "build": "tsc -b --noCheck && vite build",
    "build:fabric": "tsc -b --noCheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix data test",
    "test:watch": "vitest",
    "test:fabric": "node scripts/open-fabric-portal.mjs"
  },
  "dependencies": {
    "@microsoft/fabric-app-data": "1.1.0",
    "@microsoft/fabric-app-data-embed-client": "1.0.0",
    "@microsoft/fabric-app-data-proxy": "1.0.0",
    "@microsoft/fabric-datagrid": "2.0.0",
    "@microsoft/fabric-embedded-host": "^1.36.0-alpha.1620",
    "@microsoft/fabric-visuals": "2.0.0",
    "@microsoft/fabric-visuals-core": "2.0.0",
    "@microsoft/rayfin-auth-provider-fabric": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-client": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-connector-fabric-semanticmodel": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-connectors": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-core": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-data": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-functions": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-lib": "^1.36.0-alpha.1620",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@microsoft/fabric-app-data-cli": "2.0.0",
    "@microsoft/fabric-app-data-cli-proxy": "2.0.0",
    "@microsoft/rayfin-cli": "^1.36.0-alpha.1620",
    "@microsoft/rayfin-mcp": "^1.36.0-alpha.1620",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "rollup-plugin-license": "^3.7.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
